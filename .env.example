# URL publique du site (canonicals, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL="https://www.golfchateaularc.com"

# Back-office : le dépôt GitHub sert de stockage (cf. README).
# Jeton fine-grained limité au dépôt, permission « Contents : Read and write ».
# En local, laissé vide, le jeton de la GitHub CLI (gh auth token) est utilisé.
GITHUB_TOKEN=""
# Comptes : une entrée par compte, séparées par des virgules,
# générées par `node scripts/creer-compte-admin.mjs`.
ADMIN_COMPTES=""
# Clé aléatoire de 32 caractères minimum : openssl rand -base64 32
ADMIN_SECRET_SESSION=""

# Suivi des visites (accueil du back-office) : Redis Upstash, offre gratuite.
# Renseignées automatiquement par Vercel → Storage → Upstash for Redis.
# En local, laissées vides, un stockage en mémoire est utilisé.
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# API de contenu externe (optionnelle, non utilisée pour le bandeau)
API_BASE_URL=""
API_TOKEN=""

# Secret partagé pour le webhook POST /api/revalidate
REVALIDATE_SECRET=""
